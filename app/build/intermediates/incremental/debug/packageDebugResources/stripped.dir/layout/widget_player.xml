<?xml version="1.0" encoding="utf-8"?>
<!--
    Home-screen widget (RemoteViews-compatible).
    Layout: track text on the left | three transport buttons on the right.

    Restrictions: only RemoteViews-supported view types are allowed
    (LinearLayout, FrameLayout, TextView, ImageView, ImageButton, etc.).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_card"
    android:padding="12dp">

    <!-- Tap target for opening the app — wraps title + artist -->
    <LinearLayout
        android:id="@+id/widget_text_area"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingEnd="10dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Nothing playing" />

        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Tap a track in Lmusic to start" />

    </LinearLayout>

    <!-- Transport controls — prev / play-pause / next -->
    <ImageButton
        android:id="@+id/widget_prev"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_skip_prev"
        android:background="@drawable/bg_circle_glass"
        android:padding="8dp"
        android:contentDescription="Previous" />

    <ImageButton
        android:id="@+id/widget_play_pause"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/ic_play"
        android:background="@drawable/bg_circle_play"
        android:padding="10dp"
        android:contentDescription="Play or pause"
        android:layout_marginHorizontal="6dp" />

    <ImageButton
        android:id="@+id/widget_next"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_skip_next"
        android:background="@drawable/bg_circle_glass"
        android:padding="8dp"
        android:contentDescription="Next" />

</LinearLayout>
