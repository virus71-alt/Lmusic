<?xml version="1.0" encoding="utf-8"?>
<!--
    Home — YT Music-style personalised landing page.

    Sections (top → bottom):
      1. Greeting
      2. Your Weekly Mix      (auto-downloaded recommendations, kept 7 days)
      3. Listen again         (recent library tracks)
      4. For-You shelves      (built by RecommendationEngine; appended at runtime)
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:scrollbars="none"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="96dp">

        <!-- ── Greeting ───────────────────────────────────────────────── -->
        <TextView
            android:id="@+id/tv_greeting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:text="Good evening"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/tv_greeting_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:layout_marginTop="2dp"
            android:text="Picked for you, from your music"
            android:textSize="13sp"
            android:textColor="@color/text_tertiary" />

        <!-- ── Your Weekly Mix ────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/section_mix"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="24dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Your Weekly Mix"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/tv_mix_sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fresh downloads · kept for 7 days"
                        android:textSize="11sp"
                        android:textColor="@color/text_tertiary" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btn_mix_play_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_tab_active"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="Play all"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/on_doodle_peach" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/row_mix"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="20dp" />
            </HorizontalScrollView>
        </LinearLayout>

        <!-- ── Listen again ───────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/section_recent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="28dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:text="Listen again"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/row_recent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="20dp" />
            </HorizontalScrollView>
        </LinearLayout>

        <!-- ── For-You recommendation shelves (appended at runtime) ──── -->
        <LinearLayout
            android:id="@+id/shelves_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <ProgressBar
            android:id="@+id/shelves_loading"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="32dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_home_hint"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="48dp"
            android:gravity="center"
            android:text="Download a few songs you love and Home will fill up with personalised picks."
            android:textSize="13sp"
            android:textColor="@color/text_tertiary"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
