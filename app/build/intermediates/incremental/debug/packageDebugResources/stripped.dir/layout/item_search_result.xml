<?xml version="1.0" encoding="utf-8"?>
<!--
    Search result row, inspired by Echo's `item_quick_search_media.xml` but with
    a Play + Download trailing action pair (Lmusic-specific).

    Layout: 64dp thumbnail | 2-line title + 1-line subtitle (alpha=0.66) | actions
    No card background, no duration text — keeps the list visually quiet so the
    cover art does the work.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="8dp"
    android:layout_marginBottom="4dp"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical">

    <!-- 64dp thumbnail with 8dp corner radius (echo's "itemCorner" token) -->
    <ImageView
        android:id="@+id/iv_thumbnail"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:scaleType="centerCrop"
        android:clipToOutline="true"
        android:background="@drawable/bg_thumbnail_placeholder"
        android:contentDescription="Thumbnail" />

    <!-- Text -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginHorizontal="12dp">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_channel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurface"
            android:alpha="0.66"
            android:maxLines="1"
            android:ellipsize="end" />

        <!--
            Duration stays in the layout for the playlist-info case (we show
            "12 tracks" there) but is hidden in normal search results.
        -->
        <TextView
            android:id="@+id/tv_duration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="11sp"
            android:textColor="?attr/colorOnSurface"
            android:alpha="0.5"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Actions: play (primary) + download (secondary, icon-only) -->
    <ImageButton
        android:id="@+id/btn_play_stream"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/ic_play"
        android:background="@drawable/bg_play_button"
        android:padding="11dp"
        android:contentDescription="Play"
        android:layout_marginEnd="4dp" />

    <ImageButton
        android:id="@+id/btn_download"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_download"
        android:background="@drawable/bg_icon_button"
        android:padding="10dp"
        android:contentDescription="Download" />

</LinearLayout>
