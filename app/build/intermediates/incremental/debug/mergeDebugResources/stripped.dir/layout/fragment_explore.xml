<?xml version="1.0" encoding="utf-8"?>
<!--
    Explore screen — YouTube search + Google account + genre quick-picks.

    Layout order (top → bottom):
       1. Search bar (always visible — full width, with leading icon)
       2. Account card (sign in for Liked/Playlists)
       3. Genre chip strip (Lofi · Pop · Rock · Hip Hop · Chill · EDM ·
                            ─ separator ─ · Liked · Playlists)
       4. Results / loading / empty state (fills remaining space)

    UI inspiration: echo-nightly's quick-search row + their pill-chip tabs,
    adapted to Lmusic's accent palette.  Mini-player is global, NOT in this fragment.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- ── Search bar (full-width, inline submit on Enter) ────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_card"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:paddingHorizontal="14dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_search"
            android:alpha="0.5"
            android:contentDescription="Search" />

        <EditText
            android:id="@+id/et_search"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Search YouTube…"
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="@color/text_tertiary"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:singleLine="true"
            android:importantForAutofill="no"
            android:paddingHorizontal="10dp" />

        <!-- Trailing clear-text button (shown only when there's text) -->
        <ImageButton
            android:id="@+id/btn_search"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_close"
            android:background="@drawable/bg_icon_circle"
            android:padding="8dp"
            android:contentDescription="Clear search"
            android:visibility="gone" />

    </LinearLayout>

    <!-- ── Live search suggestions ─────────────────────────────────────
         Inflated by ExploreFragment as the user types, after a 300ms debounce.
         Each suggestion is a TextView row; tapping fills the search box and
         runs the query.  Invisible until there's something to show.
    -->
    <LinearLayout
        android:id="@+id/suggestions_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:paddingVertical="4dp"
        android:visibility="gone" />

    <!-- ── Genre / category chips (Echo-style horizontal scroll) ─────── -->
    <HorizontalScrollView
        android:id="@+id/chip_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp">

        <LinearLayout
            android:id="@+id/chip_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:gravity="center_vertical" />

    </HorizontalScrollView>

    <!-- ── Results / loading / empty state ──────────────────────────── -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_results"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="80dp" />

        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/empty_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp">

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_icon_circle"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/iv_empty_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_search"
                    android:alpha="0.6"
                    android:contentDescription="Empty" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Discover music"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:gravity="center" />

            <TextView
                android:id="@+id/tv_empty_sub"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Tap a category above or type to search"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurface"
                android:alpha="0.6"
                android:textAlignment="center" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
