<?xml version="1.0" encoding="utf-8"?>
<!--
    Doodle card — crisp surface fill with a thin "ink pen" charcoal stroke.
    Reused app-wide (search bars, list cards, history items) so the doodle
    look propagates without touching every layout.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/surface" />
    <corners android:radius="16dp" />
    <stroke
        android:width="1.5dp"
        android:color="@color/doodle_ink" />
</shape>
