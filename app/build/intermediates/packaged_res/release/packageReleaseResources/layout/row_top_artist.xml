<?xml version="1.0" encoding="utf-8"?>
<!--
    Single row in the Top Artists breakdown card.
    Layout: percentage label | artist name | track count, with a horizontal
    fill bar underneath whose left/right weights are set programmatically.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="8dp">

    <!-- Top row: % · name · track count -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_percent"
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/accent"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/tv_artist"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.04"
            android:textColor="?attr/colorOnSurface"
            android:alpha="0.5" />

    </LinearLayout>

    <!-- Fill bar: peach segment on left, divider segment on right. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <View
            android:id="@+id/bar_fill"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_bar_fill" />

        <View
            android:id="@+id/bar_empty"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_bar_empty" />

    </LinearLayout>

</LinearLayout>
