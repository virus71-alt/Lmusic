<?xml version="1.0" encoding="utf-8"?>
<!--
    Now Playing — "Premium Doodle" hero.
    Circular vinyl-style album art with an ink ring, a big peach play button with
    a hard offset shadow, and glass circular skip controls.
    All view IDs preserved so NowPlayingFragment.kt binds unchanged.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp">

        <!-- ── Top bar ─────────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="28dp"
            android:paddingBottom="8dp">

            <ImageButton
                android:id="@+id/btn_collapse"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_expand_down"
                android:background="@drawable/bg_circle_glass"
                android:padding="11dp"
                android:contentDescription="Collapse" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="NOW PLAYING"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:textColor="@color/text_tertiary"
                android:letterSpacing="0.18"
                android:gravity="center"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btn_sleep_timer"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_timer"
                android:background="@drawable/bg_circle_glass"
                android:padding="11dp"
                android:contentDescription="Sleep timer" />

            <ImageButton
                android:id="@+id/btn_lyrics"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_lyrics"
                android:background="@drawable/bg_circle_glass"
                android:padding="11dp"
                android:layout_marginStart="8dp"
                android:contentDescription="Lyrics" />

            <ImageButton
                android:id="@+id/btn_queue"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_queue_list"
                android:background="@drawable/bg_circle_glass"
                android:padding="11dp"
                android:layout_marginStart="8dp"
                android:contentDescription="Queue" />

            <!-- Like / favorite toggle for the currently playing track -->
            <ImageButton
                android:id="@+id/btn_like"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_favorite_border"
                android:background="@drawable/bg_circle_glass"
                android:padding="11dp"
                android:layout_marginStart="8dp"
                android:contentDescription="Favorite" />

        </LinearLayout>

        <!-- ── Circular vinyl album art ────────────────────────────── -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="32dp"
            android:gravity="center">

            <FrameLayout
                android:layout_width="280dp"
                android:layout_height="280dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_vinyl_ring"
                android:padding="10dp">

                <ImageView
                    android:id="@+id/np_cover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_vinyl_ring"
                    android:scaleType="centerCrop"
                    android:clipToOutline="true"
                    android:contentDescription="Cover art" />

                <!-- Center spindle hole -->
                <View
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_vinyl_ring" />

                <View
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_tab_active" />

            </FrameLayout>

        </FrameLayout>

        <!-- ── Title + artist ──────────────────────────────────────── -->
        <TextView
            android:id="@+id/np_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/np_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- ── Seek bar ────────────────────────────────────────────── -->
        <SeekBar
            android:id="@+id/np_seek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:progressTint="@color/accent"
            android:thumbTint="@color/doodle_peach"
            android:progressBackgroundTint="@color/divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/np_time_elapsed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:textColor="@color/text_tertiary"
                android:text="0:00" />

            <TextView
                android:id="@+id/np_time_remaining"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:textColor="@color/text_tertiary"
                android:text="-0:00" />

        </LinearLayout>

        <!-- ── Transport controls ──────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="28dp">

            <ImageButton
                android:id="@+id/np_shuffle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_shuffle"
                android:background="@null"
                android:padding="10dp"
                android:contentDescription="Shuffle"
                android:alpha="0.45" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/np_prev"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_skip_prev"
                android:background="@drawable/bg_circle_glass"
                android:padding="14dp"
                android:contentDescription="Previous" />

            <ImageButton
                android:id="@+id/np_play_pause"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:src="@drawable/ic_play"
                android:background="@drawable/bg_circle_play"
                android:padding="22dp"
                android:contentDescription="Play or pause"
                app:tint="@color/on_doodle_peach"
                android:layout_marginHorizontal="16dp" />

            <ImageButton
                android:id="@+id/np_next"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_skip_next"
                android:background="@drawable/bg_circle_glass"
                android:padding="14dp"
                android:contentDescription="Next" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/np_repeat"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_repeat"
                android:background="@null"
                android:padding="10dp"
                android:contentDescription="Repeat"
                android:alpha="0.45" />

        </LinearLayout>

        <!-- ── Playback speed chip ─────────────────────────────────── -->
        <TextView
            android:id="@+id/np_speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_circle_glass"
            android:paddingHorizontal="18dp"
            android:paddingVertical="8dp"
            android:text="1.0x"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:contentDescription="Playback speed" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="16dp" />

    </LinearLayout>

</ScrollView>
