<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_card"
    android:padding="12dp"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="5dp"
    android:clickable="true"
    android:focusable="true"
    android:stateListAnimator="@animator/card_press">

    <!-- Thumbnail / cover art -->
    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginEnd="14dp">

        <ImageView
            android:id="@+id/iv_thumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_thumbnail_placeholder"
            android:scaleType="centerCrop"
            android:clipToOutline="true"
            android:contentDescription="Cover art" />

        <ImageView
            android:id="@+id/iv_placeholder_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_music_note"
            android:alpha="0.9"
            android:contentDescription="Music" />

        <!-- Selection overlay: shows a check mark over the thumbnail -->
        <FrameLayout
            android:id="@+id/selection_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_play_button"
            android:visibility="gone">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_check"
                android:contentDescription="Selected" />
        </FrameLayout>
    </FrameLayout>

    <!-- Title + channel + duration -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tv_channel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:ellipsize="end"
            android:maxLines="1"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/tv_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/text_tertiary"
            android:ellipsize="end"
            android:maxLines="1"
            android:layout_marginTop="3dp" />
    </LinearLayout>

    <!-- Play button (visible for OK tracks) -->
    <ImageButton
        android:id="@+id/btn_play"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_play"
        android:background="@drawable/bg_play_button"
        android:scaleType="centerInside"
        android:padding="9dp"
        android:contentDescription="Play"
        android:layout_marginStart="8dp" />

    <!-- Retry button (visible for FAILED tracks) -->
    <ImageButton
        android:id="@+id/btn_retry"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_retry"
        android:background="@drawable/bg_icon_button"
        android:scaleType="centerInside"
        android:padding="9dp"
        android:contentDescription="Retry"
        android:layout_marginStart="8dp"
        android:visibility="gone" />

    <!-- Favorite (heart) toggle -->
    <ImageButton
        android:id="@+id/btn_fav"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_favorite_border"
        android:background="@drawable/bg_icon_button"
        android:scaleType="centerInside"
        android:padding="10dp"
        android:contentDescription="Favorite"
        android:layout_marginStart="6dp" />

    <!-- Delete button -->
    <ImageButton
        android:id="@+id/btn_delete"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_delete"
        android:background="@drawable/bg_icon_button"
        android:scaleType="centerInside"
        android:padding="10dp"
        android:contentDescription="Delete"
        android:layout_marginStart="6dp"
        android:alpha="0.85" />

</LinearLayout>
