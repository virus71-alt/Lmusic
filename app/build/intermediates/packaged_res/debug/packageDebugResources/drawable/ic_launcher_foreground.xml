<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
        Premium "L" monogram in gold gradient.
        The L's stem carries a note flag so the letterform reads as an
        eighth note; a small four-point sparkle sits top-right.
        All geometry stays inside the 66dp adaptive-icon safe zone.
    -->

    <!-- L letterform with note flag off the top of the stem -->
    <path android:pathData="M40,30 h10 v36 h22 v10 H40 Z
                            M50,30 C60,30 65,36 65,46 L60,46 C60,39 56,36 50,36 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="40" android:startY="28"
                android:endX="72" android:endY="80"
                android:startColor="#FFEDB2"
                android:endColor="#C8860D" />
        </aapt:attr>
    </path>

    <!-- Four-point sparkle -->
    <path android:pathData="M71,27 L72.8,31.2 L77,33 L72.8,34.8 L71,39 L69.2,34.8 L65,33 L69.2,31.2 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="65" android:startY="27"
                android:endX="77" android:endY="39"
                android:startColor="#FFF6D8"
                android:endColor="#E8B84B" />
        </aapt:attr>
    </path>
</vector>
