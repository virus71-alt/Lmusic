<?xml version="1.0" encoding="utf-8"?>
<!--
    Profile tab — redesigned per UI/profile_and_favorites/screen.png.

    Removed: avatar/profile pic, Tracks/Storage stat cards, Settings/Plugins/
             About link rows.

    Added:
       • Your Favs hero card + 2 top-artist cards
       • Listener insight card  (hours of music · distinct artists)
       • Weekly Rhythm bar chart (downloads per weekday)
       • Top Artists breakdown with percentage bars
       • Notifications toggle (functional — wires to Settings.downloadNotifications)
       • App Aesthetic info row
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none"
    android:background="@color/background"
    tools:ignore="HardcodedText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="32dp">

        <!-- ── Your Favs header ────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="8dp"
            android:paddingBottom="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Your Favs"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface" />

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_favorite"
                android:contentDescription="@null"
                android:tint="@color/accent" />

        </LinearLayout>

        <!-- ── Featured favorite card ─────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/card_fav_featured"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card"
            android:padding="14dp"
            android:layout_marginBottom="10dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/iv_fav_thumb"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:scaleType="centerCrop"
                android:clipToOutline="true"
                android:background="@drawable/bg_thumbnail_placeholder"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingHorizontal="14dp">

                <TextView
                    android:id="@+id/tv_fav_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No favorites yet"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tv_fav_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Heart any track to see it here"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurface"
                    android:alpha="0.66"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tv_fav_count_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="0 favs"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/on_doodle_peach"
                    android:background="@drawable/bg_tab_active"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.05" />

            </LinearLayout>

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_favorite"
                android:tint="@color/accent"
                android:contentDescription="@null" />

        </LinearLayout>

        <!-- ── Top artists (two side-by-side cards) ───────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:id="@+id/card_artist_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginEnd="6dp">

                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_vinyl_ring">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_music_note"
                        android:tint="@color/accent"
                        android:contentDescription="@null" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tv_artist1_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="—"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tv_artist1_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="—"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.06"
                    android:textColor="?attr/colorOnSurface"
                    android:alpha="0.5" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/card_artist_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginStart="6dp">

                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_vinyl_ring">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_music_note"
                        android:tint="@color/accent"
                        android:contentDescription="@null" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tv_artist2_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="—"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tv_artist2_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="—"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.06"
                    android:textColor="?attr/colorOnSurface"
                    android:alpha="0.5" />

            </LinearLayout>

        </LinearLayout>

        <!-- ── Listener insight (peach card, no avatar/no tracks) ───── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_doodle_card_peach"
            android:padding="18dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LMUSIC LISTENER"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.16"
                android:textStyle="bold"
                android:textColor="@color/on_doodle_peach" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_stat_hours"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="@color/on_doodle_peach" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hours of music"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.06"
                        android:textColor="@color/on_doodle_peach"
                        android:alpha="0.8" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_stat_artists"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="@color/on_doodle_peach" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Artists"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.06"
                        android:textColor="@color/on_doodle_peach"
                        android:alpha="0.8" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- ── Weekly Rhythm card ────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Weekly Rhythm"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DOWNLOADS"
                    android:textSize="9sp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.12"
                    android:textColor="?attr/colorOnSurface"
                    android:alpha="0.5" />

            </LinearLayout>

            <!-- Bars row: heights set programmatically -->
            <LinearLayout
                android:id="@+id/row_week_bars"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:gravity="bottom"
                android:baselineAligned="false" />

            <!-- Day labels -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <TextView style="@style/WeekdayLabel" android:text="M" />
                <TextView style="@style/WeekdayLabel" android:text="T" />
                <TextView style="@style/WeekdayLabel" android:text="W" />
                <TextView style="@style/WeekdayLabel" android:text="T" />
                <TextView style="@style/WeekdayLabel" android:text="F" />
                <TextView style="@style/WeekdayLabel" android:text="S" />
                <TextView style="@style/WeekdayLabel" android:text="S" />

            </LinearLayout>

        </LinearLayout>

        <!-- ── Top Artists breakdown ─────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Top Artists"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:id="@+id/list_top_artists"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tv_top_empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Download or favorite tracks to see your top artists"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurface"
                android:alpha="0.5"
                android:visibility="gone" />

        </LinearLayout>

        <!-- ── General section ────────────────────────────────────────── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="GENERAL"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.12"
            android:textStyle="bold"
            android:textColor="@color/text_tertiary" />

        <!-- Notifications row (with toggle) -->
        <LinearLayout
            android:id="@+id/row_notifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card"
            android:padding="14dp"
            android:layout_marginBottom="10dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_download"
                android:tint="@color/accent"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Download notifications"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/tv_notif_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Show progress in the shade while downloading"
                    android:textSize="11sp"
                    android:textColor="?attr/colorOnSurface"
                    android:alpha="0.5" />

            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/sw_notifications"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:thumbTint="@color/doodle_peach"
                android:trackTint="@color/divider" />

        </LinearLayout>

        <!-- App Aesthetic info row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card"
            android:padding="14dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_music_note"
                android:tint="@color/accent"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:text="App Aesthetic"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Premium Doodle"
                android:textSize="12sp"
                android:textColor="@color/accent"
                android:fontFamily="serif"
                android:textStyle="italic" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
