<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:id="@+id/main_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:animateLayoutChanges="true">

        <!-- Compact library header — parent owns the title/settings now -->
        <LinearLayout
            android:id="@+id/app_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="4dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_subtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Your downloaded tracks"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary" />

                <!-- Sort moved to inline chip row below — button hidden as binding shim -->
                <ImageButton
                    android:id="@+id/btn_sort"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:src="@drawable/ic_sort"
                    android:visibility="gone"
                    android:contentDescription="Sort" />

                <!--
                    Hidden compatibility shim: the fragment code still references
                    binding.btnSettings in the navigation callback. It's hidden so
                    the user can't tap it, and the global one in MainNavigationFragment
                    takes over.
                -->
                <ImageButton
                    android:id="@+id/btn_settings"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:src="@drawable/ic_settings"
                    android:visibility="gone"
                    android:contentDescription="Settings" />
            </LinearLayout>

            <!-- Search bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card"
                android:paddingHorizontal="14dp"
                android:layout_marginTop="14dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_search"
                    android:alpha="0.5"
                    android:contentDescription="Search" />

                <EditText
                    android:id="@+id/et_search"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Search downloads"
                    android:textColorHint="@color/text_tertiary"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14sp"
                    android:paddingHorizontal="12dp"
                    android:singleLine="true"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:importantForAutofill="no" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── Sort / group chips (echo-style horizontal scroll) ───── -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingBottom="8dp"
            android:paddingTop="4dp">

            <LinearLayout
                android:id="@+id/library_chip_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:gravity="center_vertical" />

        </HorizontalScrollView>

        <!-- Content -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/empty_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/bg_icon_circle">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_music_note"
                        android:contentDescription="No music" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tv_empty_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No downloads yet"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginTop="20dp" />

                <TextView
                    android:id="@+id/tv_empty_subtitle"
                    android:layout_width="280dp"
                    android:layout_height="wrap_content"
                    android:text="Play a YouTube video, then hold both volume buttons together for a moment to download it."
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:textAlignment="center"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingBottom="96dp"
                android:clipToPadding="false"
                android:layoutAnimation="@anim/list_load_anim" />

        </FrameLayout>
    </LinearLayout>

    <!--
        Mini player is now owned by MainNavigationFragment (single global instance),
        so this include is hidden permanently. Kept only because ViewBinding's
        generated `binding.miniPlayer` field is referenced by Snackbar anchors etc.
    -->
    <include
        android:id="@+id/mini_player"
        layout="@layout/layout_mini_player"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:visibility="gone" />

    <!-- Selection-mode toolbar — overlays the regular app bar when selecting -->
    <LinearLayout
        android:id="@+id/selection_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/background"
        android:paddingHorizontal="12dp"
        android:paddingTop="32dp"
        android:paddingBottom="14dp"
        android:visibility="gone"
        android:elevation="4dp">

        <ImageButton
            android:id="@+id/btn_selection_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_arrow_back"
            android:background="@drawable/bg_icon_button"
            android:padding="10dp"
            android:contentDescription="Cancel selection" />

        <TextView
            android:id="@+id/tv_selection_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0 selected"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginStart="12dp" />

        <ImageButton
            android:id="@+id/btn_selection_select_all"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_check"
            android:background="@drawable/bg_icon_button"
            android:padding="10dp"
            android:contentDescription="Select all" />

        <ImageButton
            android:id="@+id/btn_selection_delete"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_delete"
            android:background="@drawable/bg_icon_button"
            android:padding="10dp"
            android:contentDescription="Delete selected"
            android:layout_marginStart="6dp" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
